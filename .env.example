# Copy to .env and fill in your API keys

# AQICN ground-truth PM2.5 (https://aqicn.org/data-platform/token/)
AQICN_API_TOKEN=

# Hopsworks Feature Store & Model Registry
HOPSWORKS_API_KEY=

# OpenAQ (required for historical_backfill.py only)
OPENAQ_API_KEY=

# Weather/AQ forecasts use Open-Meteo — no API key required
